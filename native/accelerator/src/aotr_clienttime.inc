static void installClientTimers() {
    char env[8]; env[0] = 0;
    if (GetEnvironmentVariableA("AOTR_CLIENTTIME", env, sizeof(env)) && env[0] == '0') { logf("clienttime: disabled by AOTR_CLIENTTIME=0."); return; }
    int ok = 0, bad = 0;
    HANDLE fz[256]; int nf = 0;
    suspendOthers(fz, &nf, 256);
    for (int i = 0; i < CT_N; ++i) {
        const CtSite& s = kCtSite[i];
        BYTE* q = (BYTE*)(ULONG_PTR)s.patch;
        __try {
            if (memcmp(q, s.bytes, s.nbytes)) { ++bad; continue; }
        } __except (EXCEPTION_EXECUTE_HANDLER) { ++bad; continue; }
        DWORD op = 0;
        if (!VirtualProtect(q, s.len, PAGE_EXECUTE_READWRITE, &op)) { ++bad; continue; }
        q[0] = 0xE8; *(DWORD*)(q + 1) = (DWORD)(ULONG_PTR)s.stub - (s.patch + 5);
        for (BYTE k = 5; k < s.len; ++k) q[k] = 0x90;
        VirtualProtect(q, s.len, op, &op);
        FlushInstructionCache(GetCurrentProcess(), q, s.len);
        ++ok;
    }
    resumeAll(fz, nf);
    g_ctOn = ok > 0;
    logf("clienttime: %d of %d client update / display draw call sites timed (%d did not match).", ok, CT_N, bad);
}
static void ctReport(LONG f) {
    if (!g_ctOn || f <= 0) return;
    static LONG lN[CT_N]; static LONG64 lT[CT_N];
    double k = g_tscPerQpc > 0 ? 1.0 / g_tscPerQpc : 0;
    char ln[900]; int p = 0; p += wsprintfA(ln + p, "rt: client parts");
    struct { int i; LONG64 t; } top[CT_N];
    int n = 0;
    for (int i = 0; i < CT_N; ++i) {
        LONG cn = g_ctN[i] - lN[i]; LONG64 ct = rd64(&g_ctT[i]) - lT[i];
        lN[i] += cn; lT[i] += ct;
        top[n].i = i; top[n].t = ct; ++n;
    }
    for (int a = 0; a < n - 1; ++a) for (int b = a + 1; b < n; ++b) if (top[b].t > top[a].t) { int ii = top[a].i; LONG64 tt = top[a].t; top[a].i = top[b].i; top[a].t = top[b].t; top[b].i = ii; top[b].t = tt; }
    for (int a = 0; a < n && a < 14; ++a) {
        if (top[a].t <= 0) break;
        char b1[16]; p += wsprintfA(ln + p, " %s %s |", kCtName[top[a].i], msStr((LONG64)(top[a].t * k), f, b1));
        if (p > 820) break;
    }
    logf("%s", ln);
}
